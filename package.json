{
  "name": "qualification-insight",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:api-proof": "python -m unittest discover -s tests -p test_api_proof_contract.py",
    "test:db": "python3 scripts/test-database.py",
    "test:ingestion-db": "python3 scripts/test-ingestion-db.py",
    "test:e2e": "playwright test",
    "check:env": "tsx scripts/check-env.ts",
    "check:client-boundary": "node scripts/check-client-boundary.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "6.0.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
