# Copy this key-free template to an ignored .env.local for local development.
# Next.js loads the local settings; secrets stay in server modules only.
# Store an approved key in .env.local or a server secret manager at a later STEP.
# Never paste a key in chat, a command argument, a URL, a screenshot, or a report.
APP_ENV=local
DATA_MODE=live
DATA_GO_KR_SERVICE_KEY=
PUBLIC_SITE_URL=
ADS_ENABLED=false
ANALYTICS_ENABLED=false
PREVIEW_PROTECTED=false
NEXT_TELEMETRY_DISABLED=1
# DB, hosting, cron and ad account settings are deferred to their own STEP.
# Empty key/unknown data never triggers synthetic production fallback.
# Preview fixture requires PREVIEW_PROTECTED=true AND separately verified access protection.
# Production requires DATA_MODE=live and an explicit public HTTPS PUBLIC_SITE_URL.
